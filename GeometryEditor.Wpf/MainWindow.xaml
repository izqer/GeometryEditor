<Window x:Class="GeometryEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор геометрических фигур"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        Background="#EEF1F5"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="Foreground" Value="#253347"/>
            <Setter Property="BorderBrush" Value="#D5DBE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">

                            <ContentPresenter
                                ContentSource="Content"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame"
                                        Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#253347"/>
            <Setter Property="BorderBrush" Value="#D5DBE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!--Сетка приложения-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!--Левая панель элементов-->
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Background="#F8FAFC"
                BorderBrush="#D5DBE3"
                BorderThickness="0,0,1,0">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Контейнер фигур -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D5DBE3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="Фигуры"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"
                                   Margin="0,0,0,12"/>

                        <!-- Список фигур -->
                        <Button Content="Квадрат"
                        Command="{Binding SelectFigureTypeCommand}"
                        CommandParameter="Квадрат"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                        <Button Content="Треугольник"
                        Command="{Binding SelectFigureTypeCommand}"
                        CommandParameter="Треугольник"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                        <Button Content="Круг"
                        Command="{Binding SelectFigureTypeCommand}"
                        CommandParameter="Круг"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                        <Button Content="Прямоугольник"
                        Command="{Binding SelectFigureTypeCommand}"
                        CommandParameter="Прямоугольник"
                        HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                </Border>


                <!-- Контейнер свойств -->
                <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#D5DBE3"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    MinHeight="260"
                    Margin="0,0,0,12">


                    <StackPanel>
                        <TextBlock Text="Свойства"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"
                                   Margin="0,0,0,10"/>

                        <!-- Поля свойств фигуры -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Координаты X и Y -->
                            <TextBlock Grid.Row="0"
               Text="X:"
               VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0"
             Grid.Column="1"
             Margin="5,0,0,8"
             Text="{Binding XText, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="1"
               Text="Y:"
               VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1"
             Grid.Column="1"
             Margin="5,0,0,8"
             Text="{Binding YText, UpdateSourceTrigger=LostFocus}"/>

                            <!-- Радиус круга -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFigureType}"
                                 Value="Круг">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Радиус:"
                       VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                     Margin="5,0,0,0"
                     Text="{Binding RadiusText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Сторона квадрата -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFigureType}"
                                 Value="Квадрат">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Сторона:"
                       VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                     Margin="5,0,0,0"
                     Text="{Binding SideText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Ширина и высота -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFigureType}"
                                 Value="Прямоугольник">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedFigureType}"
                                 Value="Треугольник">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                       Text="Ширина:"
                       VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="5,0,0,8"
                     Text="{Binding WidthText, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="1"
                       Text="Высота:"
                       VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="5,0,0,0"
                     Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Цвет фигуры -->
                            <TextBlock Grid.Row="5"
               Text="Цвет:"
               VerticalAlignment="Center"/>

                            <!-- Палитра -->
                            <Grid Grid.Row="5"
          Grid.Column="1"
          Margin="5,0,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ColorTextBox"
                 Grid.Column="0"
                 Text="#FF0000"
                 IsReadOnly="True"
                 Margin="0,0,5,0"/>

                                <Button x:Name="ColorButton"
                Grid.Column="1"
                Content="..."
                Background="#FF0000"
                Click="ChooseColor_Click"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Контейнер созданных фигур -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#D5DBE3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Созданные фигуры"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"
                                   Margin="0,0,0,10"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Figures}"
                                 SelectedItem="{Binding SelectedFigure, Mode=TwoWay}"
                                 DisplayMemberPath="DisplayName"
                                 Background="White"
                                 Foreground="#253347"
                                 BorderThickness="0">
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Кнопка Создать/Удалить -->
                <Button Grid.Row="3"
                        Content="{Binding ActionButtonText}"
                        Command="{Binding ApplyCommand}"
                        Height="45"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        Background="#2563EB"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- Рабочая зона -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Margin="12,12,12,8"
                Background="White"
                CornerRadius="6"
                ClipToBounds="True">

            <Canvas x:Name="WorkCanvas"
                    Background="Transparent"
                    MouseLeftButtonDown="WorkCanvas_MouseLeftButtonDown"
                    MouseMove="WorkCanvas_MouseMove"
                    MouseLeftButtonUp="WorkCanvas_MouseLeftButtonUp"
                    LostMouseCapture="WorkCanvas_LostMouseCapture">

                <!-- Тестовые фигуры -->
            </Canvas>
        </Border>

        <!-- Строка сообщений -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Margin="12,0,12,8"
                Background="White"
                CornerRadius="4"
                Padding="8,4">

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="#526173"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
