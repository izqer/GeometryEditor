<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeometryEditor.ViewModels"
        xmlns:editor="using:GeometryEditor.Core.Editor"
        xmlns:picker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        x:Class="GeometryEditor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        RequestedThemeVariant="Light"
        Title="Редактор геометрических фигур"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        Background="#EEF1F5">

    <!--Сетка приложения-->
    <Grid ColumnDefinitions="250,*"
          RowDefinitions="*,36">

        <!--Левая панель элементов-->
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Background="#F8FAFC"
                BorderBrush="#D5DBE3"
                BorderThickness="0,0,1,0">

            <Grid Margin="12"
                  RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="12">

                <!-- Контейнер фигур -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D5DBE3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Фигуры"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"
                                   Margin="0,0,0,4"/>

                        <!-- Список фигур -->
                        <Button Content="Квадрат"
                                Command="{Binding SelectFigureTypeCommand}"
                                CommandParameter="Квадрат"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Треугольник"
                                Command="{Binding SelectFigureTypeCommand}"
                                CommandParameter="Треугольник"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Круг"
                                Command="{Binding SelectFigureTypeCommand}"
                                CommandParameter="Круг"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Прямоугольник"
                                Command="{Binding SelectFigureTypeCommand}"
                                CommandParameter="Прямоугольник"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Контейнер свойств -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#D5DBE3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">

                    <StackPanel Spacing="10">
                        <TextBlock Text="Свойства"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"/>

                        <Grid ColumnDefinitions="65,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="8"
                              ColumnSpacing="5">

                            <!-- Координаты X и Y -->
                            <TextBlock Grid.Row="0"
                                       Text="X:"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Y:"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                            <!-- Радиус круга -->
                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="65,*"
                                  ColumnSpacing="5"
                                  IsVisible="{Binding IsCircle}">
                                <TextBlock Text="Радиус:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RadiusText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <!-- Сторона квадрата -->
                            <Grid Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="65,*"
                                  ColumnSpacing="5"
                                  IsVisible="{Binding IsSquare}">
                                <TextBlock Text="Сторона:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SideText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <!-- Ширина и высота -->
                            <Grid Grid.Row="4"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="65,*"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8"
                                  ColumnSpacing="5"
                                  IsVisible="{Binding HasWidthHeight}">
                                <TextBlock Grid.Row="0"
                                           Text="Ширина:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="1"
                                           Text="Высота:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <!-- Палитра -->
                            <TextBlock Grid.Row="5"
                                       Text="Цвет:"
                                       VerticalAlignment="Center"/>
                            <picker:ColorPicker x:Name="FigureColorPicker"
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Color="#FF0000"
                                                IsAlphaEnabled="False"
                                                HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Контейнер созданных фигур -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#D5DBE3"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">
                        <TextBlock Text="Созданные фигуры"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253347"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Figures}"
                                 SelectedItem="{Binding SelectedFigure, Mode=TwoWay}"
                                 Background="White"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="editor:FigureItem">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Кнопка Создать/Удалить -->
                <Button Grid.Row="3"
                        Content="{Binding ActionButtonText}"
                        Command="{Binding ApplyCommand}"
                        Height="45"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        Background="#2563EB"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- Рабочая зона -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Margin="12,12,12,8"
                Background="White"
                CornerRadius="6"
                ClipToBounds="True">

            <Canvas x:Name="WorkCanvas"
                    Background="Transparent"
                    PointerPressed="WorkCanvas_PointerPressed"
                    PointerMoved="WorkCanvas_PointerMoved"
                    PointerReleased="WorkCanvas_PointerReleased"
                    PointerCaptureLost="WorkCanvas_PointerCaptureLost">

                <!-- Фигуры создаются программно -->
            </Canvas>
        </Border>

        <!-- Строка сообщений -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Margin="12,0,12,8"
                Background="White"
                CornerRadius="4"
                Padding="8,4">

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="#526173"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
